    "gray-matter": "^4.0.3",
    "motion": "^14.12.0",
    "next": "^16.4.6",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-pretty-code": "^0.14.6",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
