{
  "name": "exea-labs-blog",
  "version": "0.1.0",
  "private": true,
  "description": "Exea Labs Blog: daily notes from building ExeaLM and other Exea Labs projects.",
  "scripts": {
    "dev": "next dev",
    "sync": "python3 scripts/sync_data.py",
